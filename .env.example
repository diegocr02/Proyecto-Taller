# Copie este archivo como .env (copy .env.example .env) y ponga UNA clave de IA.
# El archivo .env NO se sube a GitHub. Nunca escriba claves en el codigo.

# Opcion 1 - Gemini (gratis, la del instructivo): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Opcion 2 - OpenAI (de pago, la mas rapida). Quite el # de las lineas para usarla:
# OPENAI_API_KEY=your_key_here
# OPENAI_MODEL=gpt-4o-mini

# Opcion 3 - Groq (gratis, contingencia): https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# Si hay varias claves, se usa OpenAI, luego Gemini, luego Groq.
# Para elegir una en particular: openai, gemini o groq
# AGENTE_PROVEEDOR=gemini

# ---- Opcionales (normalmente no hace falta tocarlas) ----
# Pruebas: con 1 no se exige clave ni se enciende el servidor MCP (lo pone tests/conftest.py)
# MODO_TEST=0
# Ruta de la base que lee el servidor MCP (por defecto data/taller.db)
# TALLER_DB=data/taller.db

# Solo para la copia de revision en XAMPP (python data/exportar_a_xampp.py)
# XAMPP_MYSQL=C:\xampp\mysql\bin\mysql.exe
# XAMPP_USUARIO=root
# XAMPP_CLAVE=
# XAMPP_BD=jorge_motors_app
